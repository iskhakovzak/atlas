[Unit]
Description=Atlas bounded catalog refresh trigger
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/atlas/catalog-refresh.env

[Service]
Type=oneshot
User=atlas-refresh
Group=atlas-refresh
EnvironmentFile=/etc/atlas/catalog-refresh.env
WorkingDirectory=/opt/atlas-catalog-refresh
ExecStart=/usr/bin/node /opt/atlas-catalog-refresh/scripts/catalog-refresh.mjs
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
