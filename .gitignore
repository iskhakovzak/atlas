# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/output/
/.playwright-cli/
/work/
/.playwright-cli/
/output/playwright/

# Incremental TypeScript cache
*.tsbuildinfo

# In-browser OCR engine, copied from node_modules by scripts/copy-ocr-assets.mjs
/public/ocr/

# Capacitor shell (mobile/): dependencies and build outputs. The generated android/ and ios/ projects
# are committed; their own .gitignore files skip the copies Capacitor makes on `cap sync`.
/mobile/node_modules/
/mobile/android/.gradle/
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/local.properties
/mobile/android/.idea/
/mobile/android/app/src/main/assets/public/
/mobile/android/app/src/main/assets/capacitor.config.json
/mobile/android/app/src/main/assets/capacitor.plugins.json
/mobile/android/app/src/main/res/xml/config.xml
/mobile/android/capacitor-cordova-android-plugins/
/mobile/ios/App/Pods/
/mobile/ios/App/build/
/mobile/ios/App/output/
/mobile/ios/App/App/public/
/mobile/ios/App/App/capacitor.config.json
/mobile/ios/App/App/config.xml
/mobile/ios/capacitor-cordova-ios-plugins/
/mobile/ios/DerivedData/
/mobile/ios/App/App.xcodeproj/xcuserdata/
/mobile/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
/deploy/upcloud/node_modules/
